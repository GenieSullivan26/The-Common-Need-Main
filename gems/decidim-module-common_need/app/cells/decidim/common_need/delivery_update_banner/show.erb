<div class="dark-card" id="basket-delivery-banner" style="padding:12px; border-color:var(--lime-bright);">
  <div style="display:flex; justify-content:space-between; align-items:center; gap:8px; cursor:pointer;" onclick="toggleDeliveryUpdatesBanner()">
    <div>
      <div style="display:flex; align-items:center; gap:6px;">
        <span class="cat-tag-chip" style="margin:0;">⏱️ DELIVERY UPDATES</span>
        <span class="mono-sub" id="banner-shift-code" style="margin:0;"><%= shift_code %></span>
      </div>
      <div style="font-size:13.5px; font-weight:800; color:var(--lime-bright); margin-top:4px;" id="banner-window-headline">
        <%= window_headline %>
      </div>
    </div>
    <button class="olive-badge" id="delivery-banner-toggle-btn" style="cursor:pointer; border-color:var(--lime-bright);">
      <%= expanded_by_default? ? "▲ Collapse" : "▼ Details" %>
    </button>
  </div>

  <!-- EXPANDABLE BODY -->
  <div id="basket-delivery-updates-body" class="<%= "hidden" unless expanded_by_default? %>" style="margin-top:10px; padding-top:10px; border-top:1px solid rgba(197,255,41,0.35);">
    <div class="item-lime-card" style="flex-direction:column; align-items:flex-start; padding:10px; margin:0 0 10px 0;">
      <div style="font-family:monospace; font-size:10px; color:var(--bg-outer); background:var(--lime-bright); padding:2px 6px; border-radius:4px; font-weight:800;">
        LOW-DATA DYNAMIC WINDOW • ZERO MAP TILES
      </div>
      <div style="font-size:14px; font-weight:800; margin-top:6px; color:var(--text-white);" id="expanded-window-title">
        <%= expanded_window_title %>
      </div>
      <div style="font-size:12px; color:var(--text-cream); margin-top:2px;" id="expanded-stops-away">
        <%= expanded_stops_away %>
      </div>
    </div>

    <!-- 4-Step Milestone Progress Bar -->
    <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:4px; font-family:monospace; font-size:9.5px; text-align:center; margin-bottom:10px;">
      <div style="background:var(--lime-primary); color:var(--bg-outer); padding:4px 2px; border-radius:4px; font-weight:800;">1. Shift Claimed ✓</div>
      <div style="background:var(--lime-primary); color:var(--bg-outer); padding:4px 2px; border-radius:4px; font-weight:800;">2. Hubs Loaded ✓</div>
      <% if narrowed? %>
        <div id="milestone-step-3" style="background:var(--lime-primary); color:var(--bg-outer); padding:4px 2px; border-radius:4px; font-weight:800;">3. Next Stop ✓</div>
      <% else %>
        <div id="milestone-step-3" style="background:var(--olive-badge); color:var(--text-white); padding:4px 2px; border-radius:4px; border:1px solid var(--lime-bright);">3. Next Stop</div>
      <% end %>
      <div style="background:var(--bg-outer); color:var(--text-cream); padding:4px 2px; border-radius:4px; opacity:0.7;">4. Delivered</div>
    </div>

    <!-- Chronological Bulk Route Stop Confirmations -->
    <div style="display:flex; flex-direction:column; gap:6px; font-size:11.5px;">
      <div style="background:var(--bg-outer); padding:8px; border-radius:8px; border:1px solid rgba(255,255,255,0.2);">
        <div style="display:flex; justify-content:space-between; font-weight:700;">
          <span>✓ Stop 1: East Oakland Collective</span>
          <span style="color:var(--lime-bright); font-family:monospace;">2:12 PM</span>
        </div>
        <div style="font-size:10.5px; color:var(--text-cream); margin-top:2px;">Crates loaded • Window set to 2:35–2:50 PM</div>
      </div>

      <div id="member-stop-2-row" style="background:var(--bg-outer); padding:8px; border-radius:8px; border:1px solid var(--olive-border);">
        <div style="display:flex; justify-content:space-between; font-weight:700;">
          <span id="member-stop-2-title"><%= narrowed? ? "✓ Stop 2: West County Sanctuary" : "⏳ Stop 2: West County Sanctuary" %></span>
          <span id="member-stop-2-time" style="color:<%= narrowed? ? "var(--lime-bright)" : "var(--olive-border)" %>; font-family:monospace;"><%= narrowed? ? "2:26 PM" : "EST. 2:26 PM" %></span>
        </div>
        <div id="member-stop-2-desc" style="font-size:10.5px; color:var(--text-cream); margin-top:2px;">
          <%= narrowed? ? "N95 masks consolidated • Window narrowed to 2:38–2:45 PM" : "Consolidating N95 masks • Confirmation narrows your window" %>
        </div>
      </div>

      <div style="background:var(--olive-badge); padding:8px; border-radius:8px; border:1.5px solid var(--lime-bright);">
        <div style="display:flex; justify-content:space-between; font-weight:800;">
          <span>● Stop 3: Your Household (62nd Ave)</span>
          <span id="member-stop-3-window" style="color:var(--lime-bright); font-family:monospace;"><%= household_window_range %></span>
        </div>
        <div id="live-handoff-note" style="font-size:10.5px; color:var(--lime-bright); font-family:monospace; margin-top:2px;">
          <%= handoff_note %>
        </div>
      </div>
    </div>

    <button class="olive-badge" style="width:100%; margin-top:8px; padding:8px; cursor:pointer; border-color:var(--lime-bright); text-align:center;" onclick="confirmVolunteerStop(2)">
      ⚡ Simulate Volunteer Confirming Stop #2 (Recalculate Window)
    </button>
  </div>
</div>
