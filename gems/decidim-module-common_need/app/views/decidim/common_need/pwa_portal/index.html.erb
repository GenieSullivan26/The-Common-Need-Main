    function adjustQty(id, delta) {
      const el = document.getElementById('qty-' + id);
      if (!el) return;
      const next = Math.max(0, parseInt(el.textContent, 10) + delta);
      el.textContent = next;

      const listEl = document.getElementById('dynamic-basket-items-list');
      if (listEl) {
        const existingRow = listEl.querySelector(`.basket-item-row[data-stepper-id="${id}"]`);
        if (next === 0) {
          if (existingRow) existingRow.remove();
        } else if (existingRow) {
          existingRow.dataset.qty = String(next);
          const qtySpan = existingRow.querySelector('.basket-row-qty');
          if (qtySpan) qtySpan.textContent = String(next);
        } else if (STEPPER_BASKET_DEFAULTS[id]) {
          const meta = STEPPER_BASKET_DEFAULTS[id];
          listEl.prepend(createBasketRowElement({
            itemName: meta.name,
            hubLabel: meta.hub,
            badgeLabel: meta.badge,
            qty: next,
