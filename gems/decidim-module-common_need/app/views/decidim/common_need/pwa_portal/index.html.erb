<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <meta name="theme-color" content="#95C623">
  <title>The Common Need • Federated Mutual Aid Network</title>
  <link rel="manifest" href="/manifest.json">
  <%= csrf_meta_tags if respond_to?(:csrf_meta_tags) %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <%= stylesheet_pack_tag "decidim_common_need", media: "all" if respond_to?(:stylesheet_pack_tag) %>
  <%= javascript_pack_tag "decidim_common_need", defer: true if respond_to?(:javascript_pack_tag) %>

  <style>
    :root {
      --bg-outer: #120924;
      --bg-phone: #160B2B;
      --bg-card-dark: #190D30;
      --lime-primary: #95C623;
      --lime-bright: #C5FF29;
      --lime-card: #88B822;
      --olive-badge: #6B5B1E;
      --olive-border: #C8B878;
      --text-white: #FFFFFF;
      --text-cream: #F4F7E8;
      --text-lime: #C5FF29;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-outer);
      color: var(--text-white);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      padding: 12px 10px 28px;
    }

    .role-switcher-box {
      width: 100%;
      max-width: 430px;
      background: rgba(27, 15, 51, 0.92);
      border: 1px solid rgba(197, 255, 41, 0.25);
      border-radius: 999px;
      padding: 6px;
      margin-bottom: 14px;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 4px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    }

    .role-btn {
      background: transparent;
      color: rgba(244, 247, 232, 0.78);
      border: 1px solid transparent;
      border-radius: 999px;
      padding: 6px 11px;
      font-size: 11.5px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 4px;
      transition: all 0.15s ease;
    }

    .role-btn.active {
      background: var(--lime-bright);
      color: #120924;
      border-color: var(--lime-bright);
      font-weight: 700;
      box-shadow: 0 2px 10px rgba(197, 255, 41, 0.25);
    }

    .phone-frame {
      width: 100%;
      max-width: 430px;
      background: linear-gradient(180deg, #160B2B 0%, #120924 100%);
      border: 2px solid rgba(197, 255, 41, 0.32);
      border-radius: 40px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      min-height: 780px;
      position: relative;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.05);
    }

    .status-bar {
      background: rgba(13, 6, 26, 0.96);
      color: rgba(244, 247, 232, 0.85);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      font-size: 11.5px;
      font-weight: 600;
      padding: 12px 22px 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .notch-pill {
      width: 76px;
      height: 14px;
      background-color: #07030F;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 999px;
    }

    .pwa-header {
      background: rgba(22, 11, 43, 0.96);
      padding: 14px 16px 12px;
      border-bottom: 1px solid rgba(197, 255, 41, 0.16);
    }

    .header-top-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 8px;
      margin-bottom: 6px;
    }

    .app-tag-pill {
      background: rgba(197, 255, 41, 0.1);
      color: var(--lime-bright);
      font-family: inherit;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.4px;
      padding: 3px 9px;
      border-radius: 999px;
      display: inline-block;
    }

    .olive-badge {
      background: rgba(197, 255, 41, 0.12);
      color: var(--lime-bright);
      border: 1px solid rgba(197, 255, 41, 0.35);
      font-family: inherit;
      font-size: 11px;
      font-weight: 700;
      padding: 6px 12px;
      border-radius: 999px;
      white-space: nowrap;
    }

    .header-subtitle {
      color: var(--text-white);
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.2px;
      margin-bottom: 8px;
    }

    .category-bar, .sub-pill-bar {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      padding: 4px 0 6px;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .category-bar::-webkit-scrollbar, .sub-pill-bar::-webkit-scrollbar {
      display: none;
    }

    .cat-pill {
      background: rgba(255, 255, 255, 0.05);
      color: rgba(244, 247, 232, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 999px;
      padding: 6px 13px;
      font-size: 11.5px;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      flex-shrink: 0;
      transition: all 0.15s ease;
    }

    .cat-pill.active {
      background: var(--lime-bright);
      color: #120924;
      border: 1px solid var(--lime-bright);
      font-weight: 700;
    }

    .kpi-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 8px;
    }

    .kpi-box {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: 14px;
      padding: 10px 12px;
    }

    .kpi-label {
      color: rgba(244, 247, 232, 0.65);
      font-family: inherit;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.3px;
    }

    .kpi-val {
      color: var(--lime-bright);
      font-family: inherit;
      font-size: 15px;
      font-weight: 800;
      margin-top: 3px;
    }

    .pwa-body {
      flex: 1;
      padding: 14px 16px 18px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 14px;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .pwa-body::-webkit-scrollbar,
    #local-ai-chat-log::-webkit-scrollbar {
      display: none;
    }

    .dark-card {
      background: #1B0F33;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      padding: 16px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
    }

    .lime-dashed-banner {
      background: rgba(197, 255, 41, 0.07);
      border: 1px solid rgba(197, 255, 41, 0.22);
      border-radius: 16px;
      padding: 11px 14px;
      color: var(--text-cream);
      font-size: 12px;
      line-height: 1.45;
    }

    .pantry-title {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      font-size: 15.5px;
      font-weight: 700;
      letter-spacing: -0.2px;
      color: var(--text-white);
      margin: 4px 0 2px;
    }

    .mono-sub {
      background: transparent;
      color: rgba(244, 247, 232, 0.68);
      font-family: inherit;
      font-size: 11.5px;
      padding: 0;
      border-radius: 6px;
      display: inline-block;
      margin-bottom: 4px;
      border: none !important;
    }

    .item-lime-card {
      background: rgba(255, 255, 255, 0.035);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      padding: 11px 13px;
      margin-top: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    .item-title {
      font-size: 13.5px;
      font-weight: 650;
      color: var(--text-white);
      margin-bottom: 2px;
      line-height: 1.3;
    }

    .cat-tag-chip {
      background: rgba(197, 255, 41, 0.12);
      color: var(--lime-bright);
      border: none;
      font-family: inherit;
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: 0.4px;
      padding: 2px 7px;
      border-radius: 6px;
      display: inline-block;
      margin-bottom: 4px;
    }

    .stepper-pill {
      background: rgba(197, 255, 41, 0.12);
      color: var(--lime-bright);
      border: 1px solid rgba(197, 255, 41, 0.35);
      border-radius: 999px;
      padding: 5px 12px;
      font-weight: 800;
      font-size: 12.5px;
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      white-space: nowrap;
    }

    .check-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 0;
      font-size: 13px;
      font-weight: 600;
    }

    .check-row input[type="checkbox"] {
      width: 18px;
      height: 18px;
      accent-color: var(--lime-bright);
    }

    .cta-olive-btn, .cta-lime-btn {
      width: 100%;
      background: var(--lime-bright) !important;
      color: #120924 !important;
      border: none !important;
      border-radius: 14px;
      padding: 13px 16px;
      font-size: 13.5px;
      font-weight: 800;
      letter-spacing: 0.2px;
      cursor: pointer;
      text-align: center;
      box-shadow: 0 4px 16px rgba(197, 255, 41, 0.22);
    }

    .dark-input {
      width: 100%;
      background: rgba(255, 255, 255, 0.05);
      color: var(--text-white);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      padding: 10px 12px;
      font-size: 13px;
      margin-top: 8px;
      outline: none;
    }

    .bottom-nav {
      background: rgba(18, 9, 36, 0.98);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding: 8px 8px 14px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
    }

    .bottom-nav.two-cols { grid-template-columns: repeat(2, 1fr); }
    .bottom-nav.three-cols { grid-template-columns: repeat(3, 1fr); }
    .bottom-nav.four-cols { grid-template-columns: repeat(4, 1fr); }
    .bottom-nav.five-cols { grid-template-columns: repeat(5, 1fr); }

    .nav-tab {
      background: transparent;
      color: rgba(244, 247, 232, 0.6);
      border: 1px solid transparent;
      border-radius: 12px;
      padding: 7px 2px;
      font-size: 10.5px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      text-align: center;
    }

    .nav-tab.active {
      background: rgba(197, 255, 41, 0.12);
      border: 1px solid rgba(197, 255, 41, 0.3);
      color: var(--lime-bright);
      font-weight: 700;
    }

    .pwa-toast {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(18, 9, 36, 0.96);
      color: var(--lime-bright);
      border: 1px solid rgba(197, 255, 41, 0.45);
      border-radius: 14px;
      padding: 11px 16px;
      font-size: 12.5px;
      font-weight: 600;
      box-shadow: 0 12px 30px rgba(0,0,0,0.85);
      z-index: 9999;
      max-width: 390px;
      width: 92%;
      text-align: center;
      transition: opacity 0.2s ease;
    }

    .cal-mode-switcher {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
      background: rgba(255, 255, 255, 0.04);
      padding: 5px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      margin-bottom: 8px;
    }

    .cal-mode-btn {
      background: transparent;
      color: rgba(244, 247, 232, 0.8);
      border: 1px solid transparent;
      border-radius: 8px;
      padding: 7px 4px;
      font-size: 11.5px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
    }

    .cal-mode-btn.active {
      background: var(--lime-bright);
      color: #120924;
      border-color: var(--lime-bright);
      font-weight: 800;
    }

    .cal-month-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 4px;
      text-align: center;
      margin-top: 6px;
    }

    .cal-weekday-hdr {
      font-size: 10px;
      color: var(--lime-bright);
      font-weight: 700;
      padding: 4px 0;
    }

    .cal-day-cell {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 8px;
      min-height: 44px;
      padding: 4px 2px;
      font-size: 11px;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.65);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
    }

    .cal-day-cell.has-events {
      border: 1px solid rgba(197, 255, 41, 0.5);
      color: var(--text-white);
      cursor: pointer;
      background: rgba(197, 255, 41, 0.08);
    }

    .cal-day-cell.selected-day {
      background: var(--lime-bright);
      color: #120924;
      border: 1px solid var(--text-white);
      font-weight: 800;
    }

    .cal-event-dot-pill {
      background: rgba(197, 255, 41, 0.16);
      color: var(--lime-bright);
      border-radius: 6px;
      font-size: 8.5px;
      font-weight: 700;
      padding: 1px 4px;
      line-height: 1.1;
    }

    .cal-day-cell.selected-day .cal-event-dot-pill {
      background-color: #120924;
      color: var(--lime-bright);
    }

    #role-view-member #member-catalog-search {
      border-radius: 999px !important;
      background: rgba(255, 255, 255, 0.06) !important;
      border: 1px solid rgba(255, 255, 255, 0.15) !important;
      padding: 9px 14px !important;
      font-size: 12.5px !important;
      color: var(--text-white);
    }

    .member-hub-card > hr {
      border: none;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      margin: 10px 0 6px !important;
    }

    .member-hub-card .item-lime-card > div:first-child > div:last-child {
      display: none;
    }

    .hidden { display: none !important; }
  </style>
</head>
<body class="common-need-pwa-body" data-controller="offline-sync">

  <!-- IN-APP NOTIFICATION TOAST -->
  <div id="pwa-toast" class="pwa-toast hidden"></div>

  <% if @unified_suite %>
    <!-- ROLE SWITCHER (Visible only on the Unified 5-Role PWA Suite) -->
    <div class="role-switcher-box" id="top-role-switcher">
      <button class="role-btn active" onclick="switchRole('member')" id="role-btn-member">🛍️ Member</button>
      <button class="role-btn" onclick="switchRole('volunteer')" id="role-btn-volunteer">🚚 Volunteer</button>
      <button class="role-btn" onclick="switchRole('nonprofit')" id="role-btn-nonprofit">🏢 Partner</button>
      <button class="role-btn" onclick="switchRole('localnode')" id="role-btn-localnode">🌐 Local Node</button>
      <button class="role-btn" onclick="switchRole('network')" id="role-btn-network">📊 Central Hub</button>
    </div>
  <% end %>

  <!-- PHONE FRAME -->
  <div class="phone-frame">
    <div class="status-bar">
      <span>9:41 AM</span>
      <div class="notch-pill"></div>
      <span id="pwa-status-auth-pill">PWA • 5G</span>
    </div>

    <!-- ACTIVE INSTANCE LINK BANNER (Shown when authenticated into a PWA) -->
    <div id="pwa-active-instance-bar" class="hidden" style="background:rgba(13,6,26,0.95); border-bottom:1px solid rgba(197,255,41,0.2); padding:7px 16px; font-size:11.5px; color:var(--lime-bright); display:flex; justify-content:space-between; align-items:center; gap:8px;">
      <span id="pwa-active-instance-text" style="font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">📍 East Oakland Local Node (#OAK-01)</span>
      <span id="pwa-active-instance-host" class="hidden">oakland-01.common-need.org</span>
      <button type="button" id="pwa-open-profile-btn" onclick="openProfileModal()" style="background:rgba(197,255,41,0.12); color:var(--lime-bright); border:1px solid rgba(197,255,41,0.35); border-radius:999px; padding:3px 10px; font-size:11px; font-weight:700; cursor:pointer; white-space:nowrap; flex-shrink:0;">
        👤 Profile
      </button>
    </div>

    <!-- IN-APP PROFILE & INSTANCE ADDRESS MODAL (Editable once logged in) -->
    <div id="pwa-profile-modal" class="hidden" style="position:absolute; inset:42px 0 0 0; background:rgba(18,9,36,0.96); backdrop-filter:blur(10px); z-index:900; padding:22px 20px; display:flex; flex-direction:column; justify-content:center;">
      <div class="dark-card" style="background:#1B0F33; border:1.5px solid rgba(197,255,41,0.4); border-radius:22px; padding:20px 18px; box-shadow:0 16px 40px rgba(0,0,0,0.6);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
          <div>
            <span class="olive-badge" id="pwa-profile-role-badge" style="font-size:10px; padding:3px 9px; border-radius:999px;">🛍️ MEMBER PROFILE</span>
            <h2 class="pantry-title" style="font-family:inherit; font-size:19px; margin:6px 0 0;">Account & Local Instance</h2>
          </div>
          <button type="button" onclick="closeProfileModal()" style="background:rgba(255,255,255,0.08); color:var(--text-white); border:1px solid rgba(255,255,255,0.15); border-radius:999px; width:30px; height:30px; font-size:14px; font-weight:700; cursor:pointer;">✕</button>
        </div>

        <div style="background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:11px 13px; margin-bottom:14px; font-size:12.5px;">
          <div style="font-weight:700; color:var(--text-white);" id="pwa-profile-name-display">Rosa Morales</div>
          <div style="color:rgba(244,247,232,0.7); font-size:11.5px; margin-top:2px;" id="pwa-profile-email-display">rosa@oakland-node.org</div>
        </div>

        <label style="font-size:12px; font-weight:600; color:var(--text-cream); display:block; margin-bottom:5px;">
          Address or ZIP Code
        </label>
        <input type="text" id="pwa-profile-address-input" class="dark-input" value="1420 62nd Ave, Oakland, CA 94621" placeholder="Enter street address or ZIP code" oninput="updateProfileInstancePreview(this.value)" style="margin:0 0 8px 0; padding:10px 12px; font-size:13px; border-radius:12px;">

        <div id="pwa-profile-instance-preview" style="background:#0D061A; color:var(--lime-bright); border:1px solid rgba(197,255,41,0.3); font-family:ui-monospace, SFMono-Regular, monospace; font-size:10.5px; padding:7px 10px; border-radius:10px; margin-bottom:16px;">
          📍 Linked Instance: East Oakland Local Node (#OAK-01)
        </div>

        <button type="button" id="pwa-profile-save-btn" class="cta-lime-btn" style="width:100%; font-size:13.5px; padding:12px; border-radius:14px; margin-top:0;" onclick="saveProfileAddressUpdate()">
          Save Address & Update Instance →
        </button>

        <button type="button" id="pwa-profile-signout-btn" onclick="signOutDecidim()" style="width:100%; margin-top:10px; background:rgba(255,255,255,0.06); color:var(--text-cream); border:1px solid rgba(255,255,255,0.16); border-radius:14px; padding:11px; font-size:13px; font-weight:700; cursor:pointer;">
          Sign Out
        </button>
      </div>
    </div>

    <!-- =========================================================
         0. SLEEK DECIDIM SIGN-ON & CREATE ACCOUNT GATE
         ========================================================= -->
    <div id="decidim-sso-gate" class="hidden" style="display:flex; flex-direction:column; justify-content:center; flex:1; padding:24px 22px;">
      <div style="text-align:center; margin-bottom:18px;">
        <span class="olive-badge" style="font-size:10px; letter-spacing:0.8px; padding:4px 10px;">THE COMMON NEED</span>
        <h1 class="pantry-title" id="decidim-sso-heading" style="font-size:25px; margin:10px 0 4px;">Sign In</h1>
        <p id="decidim-sso-subheading" style="font-size:12.5px; color:var(--text-cream); opacity:0.85;">
          Sign in with Decidim to open your local instance
        </p>
      </div>

      <div class="dark-card" style="padding:20px 18px; border-radius:22px;">
        <div id="decidim-sso-role-label" style="font-size:11.5px; font-weight:600; color:var(--text-cream); margin-bottom:8px; text-align:center;">
          Sign in as
        </div>

        <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:6px; background:#0D061A; padding:5px; border-radius:14px; margin-bottom:14px;">
          <button type="button" id="sso-card-member" onclick="selectDecidimSsoType('member')" style="background:var(--lime-card); color:var(--text-white); border:1.5px solid var(--lime-bright); border-radius:10px; padding:8px 4px; font-size:12px; font-weight:700; cursor:pointer;">
            🛍️ Member
          </button>
          <button type="button" id="sso-card-volunteer" onclick="selectDecidimSsoType('volunteer')" style="background:transparent; color:var(--text-cream); border:1.5px solid transparent; border-radius:10px; padding:8px 4px; font-size:12px; font-weight:700; cursor:pointer;">
            🚚 Volunteer
          </button>
          <button type="button" id="sso-card-nonprofit" onclick="selectDecidimSsoType('nonprofit')" style="background:transparent; color:var(--text-cream); border:1.5px solid transparent; border-radius:10px; padding:8px 4px; font-size:12px; font-weight:700; cursor:pointer;">
            🏢 Partner
          </button>
        </div>

        <div id="decidim-sso-name-group" class="hidden">
          <label id="decidim-sso-name-label" style="font-size:12px; font-weight:600; color:var(--text-cream); display:block; margin-bottom:4px;">Full Name</label>
