    function cycleTimelineStatus(id) {
      const states = ['Mobilizing', 'In Progress', 'Ready', '✓ Done'];
      const timeline = readOrgStore('common_need_org_timeline', DEFAULT_COALITION_TIMELINE);
      const item = timeline.find(m => m.id === id);
      if (!item) return;
      const idx = states.indexOf(item.status);
      item.status = states[(idx + 1) % states.length];
      writeOrgStore('common_need_org_timeline', timeline);
      renderCoalitionLogistics();
    }

