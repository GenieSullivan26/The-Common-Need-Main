    function escapeNavHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function escapeJsArg(str) {
      return String(str || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");
    }

    function getActiveInstanceInfo() {
      try {
        const s = JSON.parse(sessionStorage.getItem('common_need_decidim_sso') || 'null');
        if (s && s.instanceCode) {
          return { code: s.instanceCode, name: s.instanceName || 'Local Node', userName: s.name || '' };
        }
      } catch (e) {}
      return { code: '<%= current_local_node_code %>', name: 'East Oakland Local Node', userName: '' };
    }

    function getStoredLiveSurplusItems() {
      try {
        const parsed = JSON.parse(localStorage.getItem('common_need_live_surplus_items') || '[]');
        return Array.isArray(parsed) ? parsed : [];
      } catch (e) {
        return [];
      }
    }

    function inferSurplusCategory(name) {
      const lower = String(name || '').toLowerCase();
      if (/diaper|formula|baby|infant|stroller|toy|backpack|youth|kid/.test(lower)) return 'youth_services';
      if (/walker|wheelchair|cane|blood pressure|wound|medical|medicine/.test(lower)) return 'medical';
      if (/mask|n95|filter|sanitizer|hygiene/.test(lower)) return 'health';
      if (/narcan|naloxone|lantern|battery|first-aid|safety/.test(lower)) return 'public_safety';
      if (/coat|jacket|blanket|sleeping bag|tent|heater|dehumidifier|rent/.test(lower)) return 'housing';
      if (/dog|cat|kibble|pet|leash|flea/.test(lower)) return 'pets';
      if (/seed|compost|soil|plant|garden/.test(lower)) return 'garden';
      if (/laptop|computer|book|ged|esl|study/.test(lower)) return 'education';
      if (/boot|ppe|hardhat|vest|tool|union/.test(lower)) return 'employment';
      if (/paint|brush|sketch|art|canvas/.test(lower)) return 'arts';
      if (/soccer|ball|yoga|bike|park/.test(lower)) return 'recreation';
      return 'food';
    }

    function syncCalendarDateOptionsAndGrid() {
      const allCards = Array.from(document.querySelectorAll('#member-calendar-events-list .calendar-event-card'));
      const dayCounts = {};
      allCards.forEach(c => {
        const d = (c.dataset.day || '').trim();
        if (d) dayCounts[d] = (dayCounts[d] || 0) + 1;
      });

      const dateSelect = document.getElementById('calendar-date-select');
      if (dateSelect) {
        const existingVals = new Set(Array.from(dateSelect.options).map(o => o.value));
        Object.keys(dayCounts).forEach(dayStr => {
          if (!existingVals.has(dayStr)) {
            const opt = document.createElement('option');
            opt.value = dayStr;
            opt.textContent = dayStr;
            dateSelect.appendChild(opt);
          }
        });
      }

      const gridEl = document.getElementById('november-calendar-grid');
      if (gridEl) {
        const dayNumMap = {
          'Tue Nov 3': 3,
          'Thu Nov 5': 5,
          'Sat Nov 7': 7,
          'Sun Nov 8': 8,
          'Wed Nov 11': 11,
          'Sat Nov 14': 14,
          'Sun Nov 15': 15,
          'Thu Nov 19': 19
        };
        const numToDayStr = {};
        Object.entries(dayNumMap).forEach(([label, num]) => { numToDayStr[num] = label; });

        Array.from(gridEl.querySelectorAll('.cal-day-cell')).forEach(cell => {
          const numSpan = cell.querySelector('span:first-child');
          const dayNum = numSpan ? parseInt(numSpan.textContent || '0', 10) : 0;
          const dayLabel = cell.dataset.gridDay || numToDayStr[dayNum];
          if (!dayLabel) return;
          const cnt = dayCounts[dayLabel] || 0;
          let pill = cell.querySelector('.cal-event-dot-pill');
          if (cnt > 0) {
            cell.classList.add('has-events');
            cell.dataset.gridDay = dayLabel;
            cell.onclick = () => selectCalendarDayFromGrid(dayLabel);
            if (!pill) {
              pill = document.createElement('span');
              pill.className = 'cal-event-dot-pill';
              cell.appendChild(pill);
            }
            pill.textContent = `${cnt} ${cnt === 1 ? 'Event' : 'Events'}`;
          } else if (pill && !['Tue Nov 3', 'Thu Nov 5', 'Sat Nov 7', 'Sun Nov 8'].includes(dayLabel)) {
            pill.remove();
            cell.classList.remove('has-events', 'selected-day');
            cell.onclick = null;
          }
        });
      }
    }

