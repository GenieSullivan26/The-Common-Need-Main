  <!-- INTERACTIVE PWA RUNTIME & HOTWIRE FALLBACK -->
  <script>
    let basketCount = 2;
    let leafletMap = null;
    let peeredNodeCount = 14;
    let openRequestsCount = 3;
    let toastTimer = null;

    const categoryDisplayNames = {
      all: 'All 19 Decidim Community Categories',
      arts: '🎨 Arts (Studio Supplies, Screenprinting & Community Murals)',
      education: '📚 Education (Refurbished Laptops, ESL/GED & Tutoring)',
      garden: '🌱 Garden (Heirloom Seeds, Vegetable Starts & Compost)',
      pets: '🐾 Pets (Companion Animal Kibble, Flea Care & Leashes)',
      health: '😷 Health (N95 Respirators, Clean Air Filters & Hygiene)',
      mental_health: '🧠 Mental health (Bilingual Peer Counseling & Somatic Care)',
      medical: '🩺 Medical (Mobility Walkers, Blood Pressure Cuffs & Wound Care)',
      legal_aid: '⚖️ Legal aid (Eviction Defense, Expungement & Immigration)',
      employment: '🛠️ Employment (Union Apprenticeship Prep & OSHA Work Boots/PPE)',
      food: '🍎 Food (Organic Produce, Staple Grain Boxes & Nourishment)',
      housing: '🏠 Housing (Emergency Rent Relief & Weatherization/Mold Kits)',
      public_safety: '🛟 Public safety (Narcan Overdose Reversal & Safety Escorts)',
      recreation: '⚽ Recreation (Soccer/Basketball Gear, Yoga Mats & Park Passes)',
      youth_services: '🎒 Youth services (STEM Backpacks, Infant Diapers & Mentorship)',
      social_services: '📋 Social services (CalFresh/SNAP, Medi-Cal, WIC & LIHEAP)',
      public_sector: '🏛️ Public sector (Municipal IDs, Transit Waivers & Paratransit)',
      co_ops: '🌻 Co-ops (Worker Co-op Sourdough, Olive Oil & Roasts)',
      veteran_services: '🎖️ Veteran services (VA Disability Claims, DD-214 & Care Packs)',
      mutual_aid: '🤝 Mutual Aid (Solidarity Hygiene, First-Aid & Power Outage Kits)'
    };

    function showToast(message) {
      const toast = document.getElementById('pwa-toast');
      if (!toast) return;
      toast.textContent = message;
      toast.classList.remove('hidden');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.add('hidden');
      }, 3600);
    }

    function switchRole(role) {
      const ssoGate = document.getElementById('decidim-sso-gate');
      if (ssoGate) ssoGate.classList.add('hidden');
      const profileModal = document.getElementById('pwa-profile-modal');
      if (profileModal) profileModal.classList.add('hidden');
      toggleMemberNavDropdown(false);
      togglePartnerNavDropdown(false);
      ['member', 'volunteer', 'nonprofit', 'localnode', 'network'].forEach(r => {
        const viewEl = document.getElementById('role-view-' + r);
        const btnEl = document.getElementById('role-btn-' + r);
        if (viewEl) viewEl.classList.toggle('hidden', r !== role);
        if (btnEl) btnEl.classList.toggle('active', r === role);
      });
      if (['member', 'volunteer', 'nonprofit'].includes(role) && typeof syncActiveSessionForRole === 'function') {
        syncActiveSessionForRole(role);
      } else {
        const instBarEl = document.getElementById('pwa-active-instance-bar');
        if (instBarEl) instBarEl.classList.add('hidden');
      }
      if (role === 'volunteer' && !leafletMap) {
        setTimeout(initLeafletMap, 200);
      }
    }

    function toggleMemberNavDropdown(forceOpen) {
      const dropdownEl = document.getElementById('member-nav-dropdown');
      if (!dropdownEl) return;
      const isHidden = dropdownEl.classList.contains('hidden');
      const shouldOpen = typeof forceOpen === 'boolean' ? forceOpen : isHidden;
      dropdownEl.classList.toggle('hidden', !shouldOpen);
      if (shouldOpen) togglePartnerNavDropdown(false);
    }

    function togglePartnerNavDropdown(forceOpen) {
      const dropdownEl = document.getElementById('partner-nav-dropdown');
      if (!dropdownEl) return;
      const isHidden = dropdownEl.classList.contains('hidden');
      const shouldOpen = typeof forceOpen === 'boolean' ? forceOpen : isHidden;
      dropdownEl.classList.toggle('hidden', !shouldOpen);
      if (shouldOpen) toggleMemberNavDropdown(false);
    }

    document.addEventListener('click', (ev) => {
      const memberDrop = document.getElementById('member-nav-dropdown');
      const memberBtn = document.getElementById('member-top-menu-btn');
      if (memberDrop && !memberDrop.classList.contains('hidden')) {
        if (!memberDrop.contains(ev.target) && (!memberBtn || !memberBtn.contains(ev.target))) {
          memberDrop.classList.add('hidden');
        }
      }
      const partnerDrop = document.getElementById('partner-nav-dropdown');
      const partnerBtn = document.getElementById('partner-top-menu-btn');
      if (partnerDrop && !partnerDrop.classList.contains('hidden')) {
        if (!partnerDrop.contains(ev.target) && (!partnerBtn || !partnerBtn.contains(ev.target))) {
          partnerDrop.classList.add('hidden');
        }
      }
    });

    function toggleMemberGeminiMode(mode) {
      const taskPanel = document.getElementById('member-paperwork-task-panel');
      if (!taskPanel) return;
      const shouldShow = mode === 'task'
        ? true
        : (mode === 'chat' ? false : taskPanel.classList.contains('hidden'));
      taskPanel.classList.toggle('hidden', !shouldShow);
    }

    function resetMemberGeminiChat() {
      switchMemberTab(5);
      toggleMemberGeminiMode('chat');
      const heroEl = document.getElementById('member-gemini-hero');
      if (heroEl) heroEl.classList.remove('hidden');
      const viewportEl = document.getElementById('member-navigator-viewport');
      if (viewportEl) viewportEl.style.justifyContent = 'center';
      const chatLog = document.getElementById('local-ai-chat-log');
      if (chatLog) {
        chatLog.innerHTML = '';
        chatLog.classList.add('hidden');
      }
      const inputEl = document.getElementById('local-ai-user-input');
      if (inputEl) inputEl.value = '';
    }

    function triggerMemberVoicePrompt() {
      const inputEl = document.getElementById('local-ai-user-input');
      if (inputEl) {
        inputEl.value = 'Find fresh produce, garden seeds & CalFresh assistance';
        inputEl.focus();
      }
      showToast('🎙️ Listening on Local Node <%= current_local_node_code %> (Zero Cloud Voice)...');
    }

    function switchMemberTab(tabIndex) {
      toggleMemberNavDropdown(false);
      [1, 2, 4, 5, 6].forEach(i => {
        const tabEl = document.getElementById('member-tab-' + i);
        const navEl = document.getElementById('m-nav-' + i);
        if (tabEl) tabEl.classList.toggle('hidden', i !== tabIndex);
        if (navEl) navEl.classList.toggle('active', i === tabIndex);
      });
      const pageNames = {
        5: 'Resource Navigator',
        1: 'Browse',
        2: 'Basket',
        6: 'Calendar',
        4: 'Vote'
      };
      const indicatorEl = document.getElementById('member-top-page-indicator');
      if (indicatorEl) indicatorEl.textContent = pageNames[tabIndex] || 'Resource Navigator';

      const showCatalogControls = (tabIndex === 1);
      const headerEl = document.getElementById('member-pwa-header');
      if (headerEl) headerEl.classList.toggle('hidden', !showCatalogControls);
    }

    let activeCalendarViewMode = 'list';

    function switchCalendarViewMode(mode) {
      activeCalendarViewMode = mode;
      ['list', 'grid'].forEach(m => {
        const btn = document.getElementById('cal-view-btn-' + m);
        if (btn) btn.classList.toggle('active', m === mode);
      });

      const listContainer = document.getElementById('calendar-list-view-container');
      const gridContainer = document.getElementById('calendar-grid-view-container');

      if (listContainer) listContainer.classList.remove('hidden');
      if (gridContainer) gridContainer.classList.toggle('hidden', mode !== 'grid');
    }

    function selectCalendarDayFromGrid(day) {
      const dateSelect = document.getElementById('calendar-date-select');
      if (dateSelect) dateSelect.value = day;

      document.querySelectorAll('#november-calendar-grid .cal-day-cell.has-events').forEach(cell => {
        cell.classList.toggle('selected-day', day !== 'all' && cell.dataset.gridDay === day);
      });

      filterMemberCalendar();

      const banner = document.getElementById('calendar-grid-selection-banner');
      if (banner) {
        banner.textContent = day === 'all'
          ? 'Showing all November 2026 partner events below • Tap a date cell to filter'
          : `Filtered to ${day} • Showing matching partner events below`;
      }
    }

    const volunteerNavSteps = [
      { counter: '[ ↱ ] LEG 1 OF 3 • STEP 1/4', dist: '5.8 mi (9 min)', text: 'Head northwest on MacArthur Blvd and merge onto I-580 W toward West Oakland.' },
      { counter: '[ ↖ ] LEG 1 OF 3 • STEP 2/4', dist: '0.6 mi (2 min)', text: 'Take Exit 19C toward West St / San Pablo Ave and merge onto 36th St toward Stop #2.' },
      { counter: '[ ↰ ] LEG 1 OF 3 • STEP 3/4', dist: '0.4 mi (1 min)', text: 'Turn left onto San Pablo Ave toward 31st St.' },
      { counter: '[ 🏁 ] LEG 1 OF 3 • STEP 4/4', dist: '0.0 mi (Arrive)', text: 'Arrive at Stop #2: West County Mutual Aid Care Hub (3115 San Pablo Ave) on right.' }
    ];
    let currentVolNavIndex = 1;

    function stepVolunteerNav(delta) {
      currentVolNavIndex = (currentVolNavIndex + delta + volunteerNavSteps.length) % volunteerNavSteps.length;
      const step = volunteerNavSteps[currentVolNavIndex];
      const counterEl = document.getElementById('nav-step-counter');
      const distEl = document.getElementById('nav-step-dist');
      const textEl = document.getElementById('nav-instruction-text');
      if (counterEl) counterEl.textContent = step.counter;
      if (distEl) distEl.textContent = step.dist;
      if (textEl) textEl.textContent = step.text;
    }

    function speakCurrentNavStep() {
      const step = volunteerNavSteps[currentVolNavIndex];
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(step.text);
        window.speechSynthesis.speak(utter);
      }
      showToast('🔊 Voice Navigation: "' + step.text + '"');
    }

    function filterMemberCalendar() {
      const searchEl = document.getElementById('calendar-search-input');
      const dateSelect = document.getElementById('calendar-date-select');
      const orgSelect = document.getElementById('calendar-org-select');
      const topicSelect = document.getElementById('calendar-topic-select');

      const query = (searchEl ? searchEl.value : '').toLowerCase().trim();
      const selDate = dateSelect ? dateSelect.value : 'all';
      const selOrg = orgSelect ? orgSelect.value : 'all';
      const selTopic = topicSelect ? topicSelect.value : 'all';

      let visibleCount = 0;

      document.querySelectorAll('#member-calendar-events-list .calendar-event-card').forEach(card => {
        const cardDay = card.dataset.day || '';
        const cardOrg = card.dataset.org || '';
        const cardTopic = card.dataset.topic || '';
        const cardText = (card.textContent + ' ' + (card.dataset.keywords || '')).toLowerCase();

        const matchesDate = (selDate === 'all' || cardDay === selDate);
        const matchesOrg = (selOrg === 'all' || cardOrg === selOrg);
        const matchesTopic = (selTopic === 'all' || cardTopic === selTopic);
        const matchesQuery = (!query || cardText.includes(query));

        const show = matchesDate && matchesOrg && matchesTopic && matchesQuery;
        card.style.display = show ? 'block' : 'none';
        if (show) visibleCount += 1;
      });

      const countEl = document.getElementById('cal-total-count');
      if (countEl) countEl.textContent = visibleCount;
    }

    let activeRsvpModalContext = null;

    function slugifyEventId(title) {
      return 'ev-' + String(title || 'event')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '')
        .slice(0, 64);
    }

    function getEventCardId(card) {
      if (!card) return '';
      if (card.dataset.eventId) return card.dataset.eventId;
      const titleText = card.querySelector('.pantry-title')?.textContent || 'partner-event';
      const id = card.dataset.liveEventId || slugifyEventId(titleText);
      card.dataset.eventId = id;
      return id;
    }

    function getStoredLivePartnerEvents() {
      try {
        const parsed = JSON.parse(localStorage.getItem('common_need_live_partner_events') || '[]');
        return Array.isArray(parsed) ? parsed : [];
      } catch (e) {
        return [];
      }
    }

    function getStoredEventRsvps() {
      try {
        const parsed = JSON.parse(localStorage.getItem('common_need_live_event_rsvps') || '{}');
        return (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) ? parsed : {};
      } catch (e) {
        return {};
      }
    }

    function saveStoredEventRsvps(rsvpMap) {
      try {
        localStorage.setItem('common_need_live_event_rsvps', JSON.stringify(rsvpMap || {}));
      } catch (e) {}
    }

    function buildQrPassSvg(code) {
      const str = String(code || 'RSVP-OAK-0000');
      let hash = 2166136261;
      for (let i = 0; i < str.length; i++) {
        hash ^= str.charCodeAt(i);
        hash = Math.imul(hash, 16777619);
      }
      const size = 9;
      let rects = '';
      for (let r = 0; r < size; r++) {
        for (let c = 0; c < size; c++) {
          const inTL = r < 3 && c < 3;
          const inTR = r < 3 && c >= size - 3;
          const inBL = r >= size - 3 && c < 3;
          let on = false;
          if (inTL || inTR || inBL) {
            const lr = r < 3 ? r : r - (size - 3);
            const lc = c < 3 ? c : c - (size - 3);
            on = !(lr === 1 && lc === 1) || (lr === 1 && lc === 1);
            if ((lr === 1 && lc === 0) || (lr === 0 && lc === 1) || (lr === 2 && lc === 1) || (lr === 1 && lc === 2)) {
              on = false;
            }
          } else {
            const bitIdx = (r * size + c) % 31;
            on = ((hash >>> bitIdx) ^ (r * 7 + c * 13)) % 2 === 0;
          }
          if (on) {
            rects += `<rect x="${c * 6 + 3}" y="${r * 6 + 3}" width="5" height="5" rx="1" fill="#120924"/>`;
          }
        }
      }
      return `<svg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">${rects}</svg>`;
    }

    function inferEventTopic(catLabel, title) {
      const lower = `${catLabel || ''} ${title || ''}`.toLowerCase();
      if (/legal|housing|eviction|veteran|public sector|id|calfresh|social/.test(lower)) return 'legal';
      if (/medical|health|mental|narcan|safety|walker/.test(lower)) return 'health';
      if (/youth|art|education|employment|union|laptop/.test(lower)) return 'youth';
      return 'food';
    }

    function buildEventCareSummaryStrip(ev, capacity) {
      const parts = [];
      if (ev.childcare !== false) parts.push('✓ Childcare Space');
      if (ev.ada !== false) parts.push('✓ ADA Accessible');
      if (ev.interp) parts.push('✓ Bilingual Interp');
      if (parts.length === 0) parts.push('✓ Live Partner Event');
      parts.push(`0 / ${capacity} Spots Registered`);
      return parts.join(' • ');
    }

    function renderPartnerEventCardDom(ev) {
      const listEl = document.getElementById('member-calendar-events-list');
      if (!listEl || !ev || !ev.id) return;
      if (listEl.querySelector(`[data-live-event-id="${ev.id}"]`)) return;

      const safeTitle = escapeNavHtml(ev.title);
      const jsTitle = escapeJsArg(ev.title);
      const loc = ev.location || '7800 MacArthur Blvd';
      const capacity = Math.max(1, parseInt(ev.capacity || '40', 10) || 40);
      const desc = ev.desc || 'Newly posted partner community event on the local node calendar. Open to all neighbors with zero means-testing.';
      const hostName = ev.hostName || 'East Oakland Collective Pantry';
      const stripText = buildEventCareSummaryStrip(ev, capacity);
      const card = document.createElement('div');
      card.className = 'dark-card calendar-event-card';
      card.dataset.liveEventId = ev.id;
      card.dataset.eventId = ev.id;
      card.dataset.day = ev.dayVal || 'Thu Nov 5';
      card.dataset.org = ev.orgCode || 'east_oakland';
      card.dataset.topic = inferEventTopic(ev.catLabel, ev.title);
      card.dataset.location = loc;
      card.dataset.keywords = `${String(ev.title).toLowerCase()} ${String(ev.catLabel).toLowerCase()} ${String(loc).toLowerCase()} ${String(hostName).toLowerCase()} live partner event`;
      card.innerHTML = `
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px; gap:6px; flex-wrap:wrap;">
          <span class="cat-tag-chip" style="margin:0;">${escapeNavHtml(ev.catLabel)}</span>
          <span class="olive-badge">${escapeNavHtml(ev.dayLabel)}</span>
        </div>
        <div class="pantry-title" style="font-size:15px;">${safeTitle}</div>
        <div class="mono-sub" style="margin:4px 0;">Hosted by: ${escapeNavHtml(hostName)} • 📍 ${escapeNavHtml(loc)}</div>
        <div class="item-lime-card" style="flex-direction:column; align-items:flex-start; font-size:12px; line-height:1.4; margin:6px 0;">
          <div>${escapeNavHtml(desc)}</div>
          <div style="font-family:monospace; font-size:10.5px; color:var(--bg-outer); background:var(--lime-bright); padding:2px 6px; border-radius:4px; font-weight:800; margin-top:4px;">
            ${escapeNavHtml(stripText)}
          </div>
        </div>
        <div style="display:flex; gap:6px; margin-top:6px;">
          <button class="olive-badge" style="flex:1; cursor:pointer; padding:8px; text-align:center; border-color:var(--lime-bright);" onclick="rsvpPartnerEvent(this, '${jsTitle}')">
            + RSVP on Local Node
          </button>
          <button class="olive-badge" style="flex:1; cursor:pointer; padding:8px; text-align:center; background:var(--bg-outer);" onclick="addItemToBasket(this, '${jsTitle} Care Pack', 'Calendar Event • ${escapeJsArg(hostName)}')">
            🚚 Request Event Kit Delivery
          </button>
        </div>
      `;
      listEl.prepend(card);
    }

    function openEventRsvpModal(context) {
      const modal = document.getElementById('pwa-event-rsvp-modal');
      if (!modal || !context) return;
      activeRsvpModalContext = context;

      const rsvps = getStoredEventRsvps();
      const existing = rsvps[context.eventId] || null;
      const defaultName = (document.getElementById('pwa-profile-name-display')?.textContent || 'Rosa Morales').trim();

      const titleEl = document.getElementById('rsvp-modal-event-title');
      const whenEl = document.getElementById('rsvp-modal-event-when');
      const whereEl = document.getElementById('rsvp-modal-event-where');
      const pillEl = document.getElementById('rsvp-modal-status-pill');
      if (titleEl) titleEl.textContent = context.title || 'Partner Event';
      if (whenEl) whenEl.textContent = context.when || '';
      if (whereEl) whereEl.textContent = context.where || '';
      if (pillEl) pillEl.textContent = existing ? '✓ CONFIRMED EVENT RSVP' : '📅 PARTNER EVENT RSVP';

      const nameInput = document.getElementById('rsvp-attendee-name');
      const qtySpan = document.getElementById('rsvp-party-size-val');
      const chkChildcare = document.getElementById('rsvp-chk-childcare');
      const chkAda = document.getElementById('rsvp-chk-ada');
      const chkInterp = document.getElementById('rsvp-chk-interp');
      const notesInput = document.getElementById('rsvp-notes-input');

      if (nameInput) nameInput.value = existing ? existing.attendeeName : defaultName;
      if (qtySpan) qtySpan.textContent = String(existing ? existing.partySize : 1);
      if (chkChildcare) chkChildcare.checked = !!(existing && existing.childcare);
      if (chkAda) chkAda.checked = !!(existing && existing.ada);
      if (chkInterp) chkInterp.checked = !!(existing && existing.interp);
      if (notesInput) notesInput.value = existing ? (existing.notes || '') : '';

      renderRsvpModalPassState(existing);
      modal.classList.remove('hidden');
    }

    function renderRsvpModalPassState(existing) {
      const passSection = document.getElementById('rsvp-modal-pass-section');
      const qrBox = document.getElementById('rsvp-modal-qr-box');
      const codeEl = document.getElementById('rsvp-modal-pass-code');
      const summaryEl = document.getElementById('rsvp-modal-pass-summary');
      const confirmBtn = document.getElementById('rsvp-confirm-btn');
      const existingActions = document.getElementById('rsvp-existing-actions');
      const pillEl = document.getElementById('rsvp-modal-status-pill');

      if (existing) {
        if (passSection) passSection.classList.remove('hidden');
        if (qrBox) qrBox.innerHTML = buildQrPassSvg(existing.passCode);
        if (codeEl) codeEl.textContent = existing.passCode;
        const tags = [];
        if (existing.childcare) tags.push('🧒 Childcare');
        if (existing.ada) tags.push('♿ ADA');
        if (existing.interp) tags.push('🗣️ Interp');
        const tagText = tags.length > 0 ? ` • ${tags.join(', ')}` : '';
        if (summaryEl) {
          summaryEl.textContent = `${existing.partySize} ${existing.partySize === 1 ? 'Spot' : 'Spots'} for ${existing.attendeeName}${tagText}`;
        }
        if (confirmBtn) confirmBtn.textContent = '✓ Save RSVP Changes';
        if (existingActions) existingActions.classList.remove('hidden');
        if (pillEl) pillEl.textContent = '✓ CONFIRMED EVENT RSVP';
      } else {
        if (passSection) passSection.classList.add('hidden');
        if (confirmBtn) confirmBtn.textContent = 'Confirm RSVP →';
        if (existingActions) existingActions.classList.add('hidden');
        if (pillEl) pillEl.textContent = '📅 PARTNER EVENT RSVP';
      }
    }

    function closeEventRsvpModal() {
      const modal = document.getElementById('pwa-event-rsvp-modal');
      if (modal) modal.classList.add('hidden');
    }

    function adjustRsvpPartySize(delta) {
      const el = document.getElementById('rsvp-party-size-val');
      if (!el) return;
      const cur = parseInt(el.textContent || '1', 10) || 1;
      el.textContent = String(Math.min(10, Math.max(1, cur + delta)));
    }

    function rsvpPartnerEvent(btn, eventTitle) {
      const card = btn ? btn.closest('.calendar-event-card') : null;
      const eventId = card ? getEventCardId(card) : slugifyEventId(eventTitle);
      const title = (card?.querySelector('.pantry-title')?.textContent || eventTitle || 'Partner Event').trim();
      const when = (card?.querySelector('.olive-badge')?.textContent || '').trim();
      const where = (card?.querySelector('.mono-sub')?.textContent || 'East Oakland Local Node').trim();

      openEventRsvpModal({ eventId, title, when, where });
    }

    function openEventRsvpById(eventId) {
      const rsvps = getStoredEventRsvps();
      const rec = rsvps[eventId];
      const card = Array.from(document.querySelectorAll('#member-calendar-events-list .calendar-event-card'))
        .find(c => getEventCardId(c) === eventId);
      openEventRsvpModal({
        eventId,
        title: rec?.eventTitle || card?.querySelector('.pantry-title')?.textContent?.trim() || 'Partner Event',
        when: rec?.eventWhen || card?.querySelector('.olive-badge')?.textContent?.trim() || '',
        where: rec?.eventWhere || card?.querySelector('.mono-sub')?.textContent?.trim() || ''
      });
    }

    function submitEventRsvpForm() {
      if (!activeRsvpModalContext || !activeRsvpModalContext.eventId) return;
      const rsvps = getStoredEventRsvps();
      const prev = rsvps[activeRsvpModalContext.eventId];

      const attendeeName = (document.getElementById('rsvp-attendee-name')?.value || '').trim() || 'Community Member';
      const partySize = Math.min(10, Math.max(1, parseInt(document.getElementById('rsvp-party-size-val')?.textContent || '1', 10) || 1));
      const childcare = !!document.getElementById('rsvp-chk-childcare')?.checked;
      const ada = !!document.getElementById('rsvp-chk-ada')?.checked;
      const interp = !!document.getElementById('rsvp-chk-interp')?.checked;
      const notes = (document.getElementById('rsvp-notes-input')?.value || '').trim();
      const passCode = prev?.passCode || ('RSVP-OAK-' + String(1000 + Math.floor(Math.random() * 9000)));

      const record = {
        eventId: activeRsvpModalContext.eventId,
        eventTitle: activeRsvpModalContext.title,
        eventWhen: activeRsvpModalContext.when,
        eventWhere: activeRsvpModalContext.where,
        attendeeName,
        partySize,
        childcare,
        ada,
        interp,
        notes,
        passCode,
        rsvpedAt: new Date().toISOString()
      };

      rsvps[record.eventId] = record;
      saveStoredEventRsvps(rsvps);
      renderRsvpModalPassState(record);
      syncAllEventRsvpStates();
      showToast(`RSVP confirmed for "${record.eventTitle}" (${partySize} ${partySize === 1 ? 'spot' : 'spots'}) — Pass ${passCode}!`);
    }

    function cancelEventRsvpById(eventId) {
      const rsvps = getStoredEventRsvps();
      const removed = rsvps[eventId];
      if (!removed) return;
      delete rsvps[eventId];
      saveStoredEventRsvps(rsvps);
      syncAllEventRsvpStates();
      showToast(`Canceled RSVP for "${removed.eventTitle}".`);
    }

    function cancelActiveModalRsvp() {
      if (!activeRsvpModalContext || !activeRsvpModalContext.eventId) return;
      cancelEventRsvpById(activeRsvpModalContext.eventId);
      closeEventRsvpModal();
    }

    function syncAllEventRsvpStates() {
      const rsvps = getStoredEventRsvps();

      document.querySelectorAll('#member-calendar-events-list .calendar-event-card').forEach(card => {
        const eventId = getEventCardId(card);
        const rsvpBtn = card.querySelector('button[onclick*="rsvpPartnerEvent"]');
        const statusStrip = card.querySelector('.item-lime-card > div:last-child');

        if (rsvpBtn && !rsvpBtn.dataset.origRsvpLabel) {
          rsvpBtn.dataset.origRsvpLabel = rsvpBtn.textContent.trim();
        }
        if (statusStrip && !statusStrip.dataset.origStatusText) {
          statusStrip.dataset.origStatusText = statusStrip.textContent.trim();
        }

        const rec = rsvps[eventId];
        if (rsvpBtn) {
          if (rec) {
            rsvpBtn.textContent = `✓ RSVPed (${rec.partySize}) • Pass`;
            rsvpBtn.style.backgroundColor = '#120924';
            rsvpBtn.style.color = 'var(--lime-bright)';
            rsvpBtn.style.borderColor = 'var(--lime-bright)';
          } else {
            rsvpBtn.textContent = rsvpBtn.dataset.origRsvpLabel || '+ RSVP on Local Node';
            rsvpBtn.style.backgroundColor = '';
            rsvpBtn.style.color = '';
          }
        }

        if (statusStrip && statusStrip.dataset.origStatusText) {
          const orig = statusStrip.dataset.origStatusText;
          if (rec) {
            if (/(\d+)\s*\/\s*(\d+)\s*Spots\s*Registered/i.test(orig)) {
              statusStrip.textContent = orig.replace(/(\d+)(\s*\/\s*\d+\s*Spots\s*Registered)/i, (_m, n, rest) => `${parseInt(n, 10) + rec.partySize}${rest}`);
            } else if (/(\d+)\s*\/\s*(\d+)\s*Slots\s*Open/i.test(orig)) {
              statusStrip.textContent = orig.replace(/(\d+)(\s*\/\s*\d+\s*Slots\s*Open)/i, (_m, n, rest) => `${Math.max(0, parseInt(n, 10) - rec.partySize)}${rest}`);
            } else {
              statusStrip.textContent = `${orig} • ✓ ${rec.partySize} RSVPed`;
            }
          } else {
            statusStrip.textContent = orig;
          }
        }
      });

      // Update Member "My Event RSVPs" summary card
      const myCard = document.getElementById('member-my-rsvps-card');
      const myCount = document.getElementById('member-my-rsvps-count');
      const myList = document.getElementById('member-my-rsvps-list');
      const rsvpRecords = Object.values(rsvps).sort((a, b) => String(b.rsvpedAt || '').localeCompare(String(a.rsvpedAt || '')));

      if (myCard && myList) {
        myCard.classList.toggle('hidden', rsvpRecords.length === 0);
        if (myCount) myCount.textContent = String(rsvpRecords.length);
        myList.innerHTML = rsvpRecords.map(rec => {
          const jsId = escapeJsArg(rec.eventId);
          const flags = [];
          if (rec.childcare) flags.push('🧒 Childcare');
          if (rec.ada) flags.push('♿ ADA');
          if (rec.interp) flags.push('🗣️ Interp');
          const flagSuffix = flags.length ? ` • ${flags.join(' ')}` : '';
          return `
            <div style="display:flex; justify-content:space-between; align-items:center; gap:8px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.09); border-radius:12px; padding:9px 11px;">
              <div style="min-width:0;">
                <div style="font-size:12.5px; font-weight:700; color:var(--text-white); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${escapeNavHtml(rec.eventTitle)}</div>
                <div class="mono-sub" style="margin:2px 0 0; font-size:11px;">${escapeNavHtml(rec.eventWhen || 'Upcoming')} • ${rec.partySize} ${rec.partySize === 1 ? 'spot' : 'spots'} • <strong style="color:var(--lime-bright);">${escapeNavHtml(rec.passCode)}</strong>${flagSuffix}</div>
              </div>
              <div style="display:flex; align-items:center; gap:6px; flex-shrink:0;">
                <button type="button" class="olive-badge" style="cursor:pointer; font-size:10.5px; padding:5px 9px; border-color:var(--lime-bright);" onclick="openEventRsvpById('${jsId}')">🎟️ Pass</button>
                <button type="button" class="basket-remove-btn" title="Cancel RSVP" aria-label="Cancel RSVP" onclick="cancelEventRsvpById('${jsId}')">✕</button>
              </div>
            </div>
          `;
        }).join('');
      }

      // Update Partner Non-Profit Portal Event & RSVP Roster (Always visible on Calendar Publisher page)
      const partnerRosterCard = document.getElementById('partner-events-rsvp-roster');
      const partnerRosterList = document.getElementById('partner-events-rsvp-list');
      const partnerTotalBadge = document.getElementById('partner-total-rsvps-badge');
      if (partnerRosterCard && partnerRosterList) {
        const liveEvents = getStoredLivePartnerEvents();
        const totalSpots = rsvpRecords.reduce((s, r) => s + (parseInt(r.partySize || 1, 10) || 1), 0);
        if (partnerTotalBadge) partnerTotalBadge.textContent = `${totalSpots} ${totalSpots === 1 ? 'Spot' : 'Spots'} RSVPed`;

        const eventBlocks = [];
        const renderedEventIds = new Set();

        liveEvents.forEach(ev => {
          renderedEventIds.add(ev.id);
          const jsEvId = escapeJsArg(ev.id);
          const rec = rsvps[ev.id];
          const cap = Math.max(1, parseInt(ev.capacity || '40', 10) || 40);
          const count = rec ? rec.partySize : 0;
          const tags = [];
          if (rec?.childcare) tags.push('🧒 Childcare');
          if (rec?.ada) tags.push('♿ ADA');
          if (rec?.interp) tags.push('🗣️ Interp');
          if (rec?.notes) tags.push(`Note: "${escapeNavHtml(rec.notes)}"`);
          eventBlocks.push(`
            <div style="background:rgba(255,255,255,0.035); border:1px solid rgba(197,255,41,0.3); border-radius:14px; padding:10px 12px;">
              <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:8px;">
                <div style="min-width:0;">
                  <div style="font-size:13px; font-weight:700; color:var(--text-white);">${escapeNavHtml(ev.title)}</div>
                  <div class="mono-sub" style="margin:2px 0 0; font-size:11px;">${escapeNavHtml(ev.dayLabel)} • 📍 ${escapeNavHtml(ev.location || '7800 MacArthur Blvd')}</div>
                </div>
                <div style="display:inline-flex; align-items:center; gap:6px; flex-shrink:0;">
                  <span class="olive-badge" style="font-size:10px; padding:3px 8px;">${count} / ${cap} RSVPed</span>
                  <button type="button" class="basket-remove-btn" title="Unpublish event" aria-label="Unpublish event" onclick="deleteLivePartnerEvent('${jsEvId}')">✕</button>
                </div>
              </div>
              ${rec ? `<div style="margin-top:6px; padding-top:6px; border-top:1px solid rgba(255,255,255,0.08); font-size:11.5px; color:var(--lime-bright);">✓ <strong>${escapeNavHtml(rec.attendeeName)}</strong> (${rec.partySize} ${rec.partySize === 1 ? 'spot' : 'spots'}) • ${escapeNavHtml(rec.passCode)}${tags.length ? ' • ' + tags.join(' • ') : ''}</div>` : `<div style="margin-top:5px; font-size:11px; color:rgba(244,247,232,0.58);">● Live on Member Calendar • Open for neighbor RSVPs</div>`}
            </div>
          `);
        });

        rsvpRecords.forEach(rec => {
          if (renderedEventIds.has(rec.eventId)) return;
          const tags = [];
          if (rec.childcare) tags.push('🧒 Childcare');
          if (rec.ada) tags.push('♿ ADA');
          if (rec.interp) tags.push('🗣️ Interp');
          if (rec.notes) tags.push(`Note: "${escapeNavHtml(rec.notes)}"`);
          eventBlocks.push(`
            <div style="background:rgba(255,255,255,0.035); border:1px solid rgba(255,255,255,0.1); border-radius:14px; padding:10px 12px;">
              <div style="display:flex; justify-content:space-between; align-items:center; gap:8px;">
                <div style="font-size:12.5px; font-weight:700; color:var(--text-white);">${escapeNavHtml(rec.eventTitle)}</div>
                <span class="olive-badge" style="font-size:10px; padding:3px 8px;">+${rec.partySize} RSVPed</span>
              </div>
              <div style="margin-top:4px; font-size:11.5px; color:var(--lime-bright);">✓ <strong>${escapeNavHtml(rec.attendeeName)}</strong> (${rec.partySize} ${rec.partySize === 1 ? 'spot' : 'spots'}) • ${escapeNavHtml(rec.passCode)}${tags.length ? ' • ' + tags.join(' • ') : ''}</div>
            </div>
          `);
        });

        partnerRosterCard.classList.remove('hidden');
        if (eventBlocks.length === 0) {
          partnerRosterList.innerHTML = `
            <div style="background:rgba(255,255,255,0.03); border:1px dashed rgba(255,255,255,0.14); border-radius:12px; padding:11px 12px; font-size:12px; color:rgba(244,247,232,0.68);">
              6 core partner clinics &amp; distributions are active on the Member Calendar. Publish an event above or tap a quick preset to broadcast a new date immediately.
            </div>
          `;
        } else {
          partnerRosterList.innerHTML = eventBlocks.join('');
        }
      }
    }

