    function initLeafletMap() {
      if (leafletMap) return;
      const mapEl = document.getElementById('leaflet-map');
      if (!mapEl || typeof L === 'undefined') return;

      leafletMap = L.map('leaflet-map', { zoomControl: true }).setView([37.785, -122.225], 12);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap • Local OSRM'
      }).addTo(leafletMap);

      const stopCoords = [
        [37.7651, -122.1755],
        [37.8215, -122.2769],
        [37.7685, -122.1960]
      ];

      L.polyline(stopCoords, { color: '#C5FF29', weight: 4 }).addTo(leafletMap);
      stopCoords.forEach((coord, idx) => {
        L.marker(coord).addTo(leafletMap).bindPopup(`Stop #${idx + 1}`);
      });
      leafletMap.fitBounds(stopCoords, { padding: [20, 20] });
    }

