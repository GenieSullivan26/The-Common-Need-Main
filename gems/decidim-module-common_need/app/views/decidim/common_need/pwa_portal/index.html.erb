    function syncActiveSessionForRole(role) {
      if (!DECIDIM_SSO_PROFILES[role]) return;
      let activeSession = null;
      try {
        activeSession = JSON.parse(sessionStorage.getItem('common_need_decidim_sso') || 'null');
      } catch (e) {}
      if (!activeSession || activeSession.userType !== role) {
        const profile = DECIDIM_SSO_PROFILES[role];
        const inst = resolveDecidimInstanceFromAddress(profile.address);
        activeSession = {
          authenticated: true,
          userType: profile.userType,
          name: profile.name,
          email: profile.email,
          address: profile.address,
          instanceCode: inst.code,
          instanceName: inst.name,
          instanceHost: inst.host
        };
      }
      if (role === 'member') updateMemberGeminiHeaderIdentity(activeSession);
      if (role === 'nonprofit') updatePartnerHeaderIdentity(activeSession);
      const instBarEl = document.getElementById('pwa-active-instance-bar');
      const instTextEl = document.getElementById('pwa-active-instance-text');
      const instHostEl = document.getElementById('pwa-active-instance-host');
      if (role === 'member' || role === 'nonprofit') {
        if (instBarEl) instBarEl.classList.add('hidden');
      } else if (instBarEl) {
        instBarEl.classList.remove('hidden');
        if (instTextEl) instTextEl.textContent = `📍 ${activeSession.instanceName} (${activeSession.instanceCode})`;
        if (instHostEl) instHostEl.textContent = activeSession.instanceHost;
      }
    }

    function selectDecidimSsoType(userType) {
      if (!DECIDIM_SSO_PROFILES[userType]) userType = 'member';
      selectedDecidimSsoType = userType;
      ['member', 'volunteer', 'nonprofit'].forEach(type => {
        const card = document.getElementById('sso-card-' + type);
        const isSelected = (type === userType);
        if (card) {
          card.style.background = isSelected ? 'var(--lime-card)' : 'transparent';
          card.style.color = isSelected ? 'var(--text-white)' : 'var(--text-cream)';
          card.style.border = isSelected ? '1.5px solid var(--lime-bright)' : '1.5px solid transparent';
        }
      });
      if (decidimAuthMode === 'signin') {
        const emailEl = document.getElementById('decidim-sso-email');
        if (emailEl) emailEl.value = DECIDIM_SSO_PROFILES[userType].email;
      }
    }

    function toggleDecidimAuthMode(mode) {
      decidimAuthMode = (mode === 'register') ? 'register' : 'signin';
      const isRegister = (decidimAuthMode === 'register');
      const headingEl = document.getElementById('decidim-sso-heading');
      const nameGroupEl = document.getElementById('decidim-sso-name-group');
      const addrGroupEl = document.getElementById('decidim-sso-address-group');
      const submitBtnEl = document.getElementById('decidim-sso-submit-btn');
      if (headingEl) headingEl.textContent = isRegister ? 'Create Account' : 'Sign In';
      if (nameGroupEl) nameGroupEl.classList.toggle('hidden', !isRegister);
      if (addrGroupEl) addrGroupEl.classList.toggle('hidden', !isRegister);
      if (submitBtnEl) submitBtnEl.textContent = isRegister ? 'Create Account →' : 'Sign In →';
    }

    function openProfileModal() {
      let session = null;
      try {
        session = JSON.parse(sessionStorage.getItem('common_need_decidim_sso') || 'null');
      } catch (e) {}
      const activeRole = ['member', 'volunteer', 'nonprofit'].find(r => {
        const el = document.getElementById('role-view-' + r);
        return el && !el.classList.contains('hidden');
      }) || 'member';
      const profile = DECIDIM_SSO_PROFILES[activeRole];
      const inst = resolveDecidimInstanceFromAddress(session?.address || profile.address);
      const cur = session || {
        userType: profile.userType,
        name: profile.name,
        email: profile.email,
        address: profile.address,
        instanceCode: inst.code,
        instanceName: inst.name
      };
      const roleBadges = { member: '🛍️ MEMBER PROFILE', volunteer: '🚚 VOLUNTEER PROFILE', nonprofit: '🏢 PARTNER PROFILE' };
      const badgeEl = document.getElementById('pwa-profile-role-badge');
      const nameEl = document.getElementById('pwa-profile-name-display');
      const emailEl = document.getElementById('pwa-profile-email-display');
      const addrInputEl = document.getElementById('pwa-profile-address-input');
      const modalEl = document.getElementById('pwa-profile-modal');
      if (badgeEl) badgeEl.textContent = roleBadges[cur.userType] || '🛍️ MEMBER PROFILE';
      if (nameEl) nameEl.textContent = cur.name;
      if (emailEl) emailEl.textContent = cur.email;
      if (addrInputEl) {
        addrInputEl.value = cur.address || '';
        updateProfileInstancePreview(addrInputEl.value);
      }
      if (modalEl) modalEl.classList.remove('hidden');
    }

    function closeProfileModal() {
      const modalEl = document.getElementById('pwa-profile-modal');
      if (modalEl) modalEl.classList.add('hidden');
    }

    function updateProfileInstancePreview(rawAddress) {
      const previewEl = document.getElementById('pwa-profile-instance-preview');
      if (!previewEl) return;
      const trimmed = (rawAddress || '').trim();
      if (!trimmed) {
        previewEl.textContent = '📍 Enter your street address or ZIP code to link your local instance';
        return;
      }
      const inst = resolveDecidimInstanceFromAddress(trimmed);
      previewEl.textContent = `📍 Linked Instance: ${inst.name} (${inst.code}) • ${inst.host}`;
    }

    function saveProfileAddressUpdate() {
      const addrInputEl = document.getElementById('pwa-profile-address-input');
      const newAddress = addrInputEl ? addrInputEl.value.trim() : '';
      if (!newAddress) return;
      const activeRole = ['member', 'volunteer', 'nonprofit'].find(r => {
        const el = document.getElementById('role-view-' + r);
        return el && !el.classList.contains('hidden');
      }) || 'member';
      const profile = DECIDIM_SSO_PROFILES[activeRole] || DECIDIM_SSO_PROFILES.member;
      const inst = resolveDecidimInstanceFromAddress(newAddress);
      const updated = {
        authenticated: true,
        userType: activeRole,
        name: profile.name,
        email: profile.email,
        address: newAddress,
        instanceCode: inst.code,
        instanceName: inst.name,
        instanceHost: inst.host
      };
      try {
        sessionStorage.setItem('common_need_decidim_sso', JSON.stringify(updated));
      } catch (e) {}
      syncActiveSessionForRole(activeRole);
      renderCollectiveCharterPreview();
      closeProfileModal();
      showToast(`✓ Profile address updated — Linked to ${inst.name} (${inst.code})`);
    }

    function openDecidimSignOn(defaultType) {
      selectDecidimSsoType(defaultType || 'member');
      ['member', 'volunteer', 'nonprofit', 'localnode', 'network'].forEach(r => {
        const viewEl = document.getElementById('role-view-' + r);
        if (viewEl) viewEl.classList.add('hidden');
      });
      closeProfileModal();
      const ssoGate = document.getElementById('decidim-sso-gate');
      if (ssoGate) ssoGate.classList.remove('hidden');
    }

    function submitDecidimSignOn() {
      const profile = DECIDIM_SSO_PROFILES[selectedDecidimSsoType] || DECIDIM_SSO_PROFILES.member;
      const addrEl = document.getElementById('decidim-sso-address');
      const nameEl = document.getElementById('decidim-sso-name');
      const emailEl = document.getElementById('decidim-sso-email');
      const addr = (addrEl?.value || '').trim() || profile.address;
      const inst = resolveDecidimInstanceFromAddress(addr);
      const session = {
        authenticated: true,
        userType: profile.userType,
        name: (nameEl?.value || '').trim() || profile.name,
        email: (emailEl?.value || '').trim() || profile.email,
        address: addr,
        instanceCode: inst.code,
        instanceName: inst.name,
        instanceHost: inst.host
      };
      try {
        sessionStorage.setItem('common_need_decidim_sso', JSON.stringify(session));
      } catch (e) {}
      switchRole(profile.userType);
      renderCollectiveCharterPreview();
      showToast(`✓ Signed In & Linked to ${inst.name} (${inst.code}) — Opened ${profile.portalLabel}`);
    }

    function signOutDecidim() {
      const lastRole = ['member', 'volunteer', 'nonprofit'].find(r => {
        const el = document.getElementById('role-view-' + r);
        return el && !el.classList.contains('hidden');
      }) || '<%= @active_role %>';
      try {
        sessionStorage.removeItem('common_need_decidim_sso');
      } catch (e) {}
      toggleMemberNavDropdown(false);
      togglePartnerNavDropdown(false);
      closeProfileModal();
      openDecidimSignOn(lastRole);
      showToast('Signed out of Decidim Local Node session.');
    }

    initPartnerOrganizingHub();
    syncLiveSurplusAndEventsToMemberPwa();
    window.addEventListener('storage', (ev) => {
      if (!ev.key || ev.key.startsWith('common_need_live_') || ev.key.startsWith('common_need_org_')) {
        syncLiveSurplusAndEventsToMemberPwa();
        initPartnerOrganizingHub();
      }
    });
    switchRole('<%= @active_role %>');
  </script>
</body>
</html>
