    function resolveDecidimInstanceFromAddress(rawAddress) {
      const addr = (rawAddress || '').trim();
      if (addr) {
        const zipMatch = addr.match(/\b(\d{5})\b/);
        if (zipMatch) {
          const byZip = DECIDIM_FEDERATED_INSTANCES.find(inst => inst.zips.includes(zipMatch[1]));
          if (byZip) return byZip;
        }
        const byKeyword = DECIDIM_FEDERATED_INSTANCES.find(inst => inst.keywords.test(addr));
        if (byKeyword) return byKeyword;
      }
      return DECIDIM_FEDERATED_INSTANCES[DECIDIM_FEDERATED_INSTANCES.length - 1];
    }

    function updateDecidimInstancePreview(rawAddress) {
      const pillEl = document.getElementById('decidim-sso-instance-pill');
      if (!pillEl) return;
      const trimmed = (rawAddress || '').trim();
      if (!trimmed) {
        pillEl.textContent = '📍 Enter your address or ZIP to link your local Decidim instance';
        return;
      }
      const inst = resolveDecidimInstanceFromAddress(trimmed);
      pillEl.textContent = `📍 Linked Instance: ${inst.name} (${inst.code})`;
    }

