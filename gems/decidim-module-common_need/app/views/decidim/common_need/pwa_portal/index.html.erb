    function sendLocalAiMessage() {
      const inputEl = document.getElementById('local-ai-user-input');
      const chatLog = document.getElementById('local-ai-chat-log');
      if (!inputEl || !chatLog) return;

      const userText = (inputEl.value || '').trim();
      if (!userText) return;

      const heroEl = document.getElementById('member-gemini-hero');
      if (heroEl) heroEl.classList.add('hidden');
      const viewportEl = document.getElementById('member-navigator-viewport');
      if (viewportEl) viewportEl.style.justifyContent = 'flex-start';
      chatLog.classList.remove('hidden');

      const userBubble = document.createElement('div');
      userBubble.style.cssText = 'align-self:flex-end; background:rgba(197,255,41,0.14); border:1px solid rgba(197,255,41,0.35); border-radius:18px 18px 4px 18px; padding:10px 14px; font-size:13px; color:var(--text-white); max-width:85%;';
      userBubble.textContent = userText;
      chatLog.appendChild(userBubble);

      syncLiveSurplusAndEventsToMemberPwa();
      const lower = userText.toLowerCase();
      const liveCards = Array.from(document.querySelectorAll('#member-tab-1 .item-lime-card'));
      const tokens = (lower.match(/[a-z0-9\-]+/g) || []).filter(w => w.length >= 3);

      const matchedDomCards = liveCards
        .map(c => {
          const title = (c.querySelector('.item-title')?.textContent || '').trim();
          const blob = c.textContent.toLowerCase();
          let score = c.dataset.liveSurplus === 'true' ? 2 : 0;
          tokens.forEach(t => {
            if (title.toLowerCase().includes(t)) score += 6;
            else if (blob.includes(t)) score += 2;
          });
          return { title, isSurplus: c.dataset.liveSurplus === 'true', score };
        })
        .filter(x => x.title && x.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 4);

      const liveItemsListHtml = matchedDomCards.length > 0
        ? matchedDomCards.map(m => `• ${m.isSurplus ? '<strong>[NEW LIVE SURPLUS]</strong> ' : ''}<strong>${escapeNavHtml(m.title)}</strong>`).join('<br>')
        : '• <strong>Organic Collard Greens &amp; 25lb Staple Grain Box</strong><br>• <strong>Urban Garden Seed/Starts &amp; 20lb Pet Kibble</strong>';

      let guidanceHtml = '';
      if (lower.includes('veteran') || lower.includes('va ') || lower.includes('calfresh') || lower.includes('social')) {
        guidanceHtml = `
          <div><strong>Social Services, CalFresh (SNAP) &amp; Veterans Navigation</strong></div>
          <div style="margin-top:4px;">• <strong>3-Day Expedited CalFresh:</strong> Households with &lt;$150 monthly income &amp; &lt;$100 liquid cash (or rent+utilities &gt; income) qualify for 3-day emergency EBT with no asset test and zero Public Charge impact.</div>
          <div>• <strong>$0 VA Intent to File:</strong> VA Form 21-0966 locks in up to 1 year of retroactive disability back-pay via an accredited VSO.</div>
          <div style="margin-top:6px;"><strong>📦 Live Free Goods &amp; Services Matched (${liveCards.length} on Instance):</strong><br>${liveItemsListHtml}</div>
          <button class="olive-badge" style="margin-top:8px; cursor:pointer;" onclick="addItemToBasket(this, 'Veteran & Social Services Care Packet', 'Veteran & Social Services')">+ Add Printed Packet &amp; Veteran Care Tote</button>
        `;
      } else if (lower.includes('legal') || lower.includes('housing') || lower.includes('public sector') || lower.includes('eviction') || lower.includes('rent')) {
        guidanceHtml = `
          <div><strong>Housing Stability, Eviction Defense &amp; Municipal ID Navigation</strong></div>
          <div style="margin-top:4px;">• <strong>Urgent 10-Business-Day Rule:</strong> File an Answer (<code>UD-105</code>) within 10 court business days of an Unlawful Detainer summons to prevent default lockout. Landlords cannot legally self-evict or shut off utilities.</div>
          <div>• <strong>Rent, LIHEAP &amp; City ID:</strong> Combine emergency back-rent grants, LIHEAP utility shutoff protection, and fee-waived Municipal IDs.</div>
          <div style="margin-top:6px;"><strong>📦 Live Free Goods &amp; Services Matched (${liveCards.length} on Instance):</strong><br>${liveItemsListHtml}</div>
          <button class="olive-badge" style="margin-top:8px; cursor:pointer;" onclick="addItemToBasket(this, 'Legal Aid, Housing Weatherization & Municipal ID Packet', 'Legal & Housing Hub')">+ Add Housing Kit &amp; Legal Packet</button>
        `;
      } else if (lower.includes('mental') || lower.includes('medical') || lower.includes('youth') || lower.includes('art') || lower.includes('diaper') || lower.includes('walker')) {
        guidanceHtml = `
          <div><strong>Full-Scope Medi-Cal, Medical Equipment, Peer Support &amp; Youth Care</strong></div>
          <div style="margin-top:4px;">• <strong>Full-Scope Medi-Cal &amp; IHSS:</strong> Available to income-eligible CA residents of all ages regardless of immigration status (no asset test), including IHSS paid family caregiving.</div>
          <div>• <strong>Zero-Barrier Delivery:</strong> Sanitized ADA walkers, N95s, non-police peer counseling kits, and Size 1–5 infant diapers deliver free.</div>
          <div style="margin-top:6px;"><strong>📦 Live Free Goods &amp; Services Matched (${liveCards.length} on Instance):</strong><br>${liveItemsListHtml}</div>
          <button class="olive-badge" style="margin-top:8px; cursor:pointer;" onclick="addItemToBasket(this, 'Holistic Health, Youth & Arts Bundle', 'Multi-Hub Care Share')">+ Add Matched Care Bundle</button>
        `;
