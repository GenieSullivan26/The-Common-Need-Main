    function initCalendarLeafletMap() {
      if (calendarLeafletMap) return;
      const mapEl = document.getElementById('calendar-events-leaflet-map');
      if (!mapEl || typeof L === 'undefined') return;

      calendarLeafletMap = L.map('calendar-events-leaflet-map', { zoomControl: true }).setView([37.779, -122.222], 12);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap'
      }).addTo(calendarLeafletMap);

      calendarMapMarkersLayer = L.layerGroup().addTo(calendarLeafletMap);
      syncCalendarMapMarkers();
    }

    function syncCalendarMapMarkers() {
      if (!calendarLeafletMap || !calendarMapMarkersLayer) return;
      calendarMapMarkersLayer.clearLayers();

      const bounds = [];
      document.querySelectorAll('#member-calendar-events-list .calendar-event-card').forEach(card => {
        if (card.style.display === 'none') return;
        const lat = parseFloat(card.dataset.lat || '37.7651');
        const lng = parseFloat(card.dataset.lng || '-122.1755');
        const titleEl = card.querySelector('.pantry-title');
        const badgeEl = card.querySelector('.olive-badge');
        const loc = card.dataset.location || 'Oakland Local Hub';
        const title = titleEl ? titleEl.textContent : 'Partner Event';
        const when = badgeEl ? badgeEl.textContent : '';

        const marker = L.marker([lat, lng]);
        marker.bindPopup(`<strong>${title}</strong><br>${when}<br>📍 ${loc}`);
        marker.addTo(calendarMapMarkersLayer);
        bounds.push([lat, lng]);
      });

      if (bounds.length > 0) {
        calendarLeafletMap.fitBounds(bounds, { padding: [24, 24], maxZoom: 14 });
      }
    }

    function resetCalendarMapBounds() {
      syncCalendarMapMarkers();
      showToast('Centered map on all visible partner event locations in #OAK-01.');
    }

    function filterMemberCalendar() {
      const searchEl = document.getElementById('calendar-search-input');
      const dateSelect = document.getElementById('calendar-date-select');
      const orgSelect = document.getElementById('calendar-org-select');
      const topicSelect = document.getElementById('calendar-topic-select');

      const query = (searchEl ? searchEl.value : '').toLowerCase().trim();
      const selDate = dateSelect ? dateSelect.value : 'all';
      const selOrg = orgSelect ? orgSelect.value : 'all';
      const selTopic = topicSelect ? topicSelect.value : 'all';

      let visibleCount = 0;

      document.querySelectorAll('#member-calendar-events-list .calendar-event-card').forEach(card => {
        const cardDay = card.dataset.day || '';
        const cardOrg = card.dataset.org || '';
        const cardTopic = card.dataset.topic || '';
        const cardText = (card.textContent + ' ' + (card.dataset.keywords || '')).toLowerCase();

        const matchesDate = (selDate === 'all' || cardDay === selDate);
        const matchesOrg = (selOrg === 'all' || cardOrg === selOrg);
        const matchesTopic = (selTopic === 'all' || cardTopic === selTopic);
        const matchesQuery = (!query || cardText.includes(query));

        const show = matchesDate && matchesOrg && matchesTopic && matchesQuery;
        card.style.display = show ? 'block' : 'none';
        if (show) visibleCount += 1;
      });

      const countEl = document.getElementById('cal-total-count');
      if (countEl) countEl.textContent = visibleCount;

      if (calendarLeafletMap) {
        syncCalendarMapMarkers();
      }
    }

