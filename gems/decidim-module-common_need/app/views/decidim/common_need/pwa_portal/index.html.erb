    function addItemToBasket(btn, itemName, hubLabel) {
      if (btn) {
        if (!btn.dataset.origLabel) btn.dataset.origLabel = btn.textContent.trim();
        btn.textContent = '✓ Added';
      }

      const listEl = document.getElementById('dynamic-basket-items-list');
      if (listEl && itemName) {
        const row = createBasketRowElement({
          itemName,
          hubLabel: hubLabel || 'Local Community Hub',
          badgeLabel: 'Solidarity Share',
          qty: 1
        });
        if (btn) {
          row._sourceButton = btn;
          row._sourceButtonLabel = btn.dataset.origLabel;
        }
        listEl.appendChild(row);
      } else {
        basketCount += 1;
      }
      updateBasketLabels();
      showToast(`Added "${itemName || 'Community Share'}" to your Mutual-Aid Basket!`);
    }

    function removeBasketItem(btn) {
      const row = btn ? btn.closest('.basket-item-row') : null;
      if (!row) return;
      const itemName = row.dataset.itemName || 'Item';
      const stepperId = row.dataset.stepperId;
      if (stepperId) {
        const qtyEl = document.getElementById('qty-' + stepperId);
        if (qtyEl) qtyEl.textContent = '0';
      }
      if (row._sourceButton && row._sourceButtonLabel) {
        row._sourceButton.textContent = row._sourceButtonLabel;
      }
      row.remove();
      updateBasketLabels();
      showToast(`Removed "${itemName}" from your Mutual-Aid Basket.`);
    }

    function updateBasketLabels() {
      const listEl = document.getElementById('dynamic-basket-items-list');
      const emptyEl = document.getElementById('basket-empty-state');
      if (listEl) {
        const rows = Array.from(listEl.querySelectorAll('.basket-item-row'));
        basketCount = rows.reduce((sum, r) => sum + Math.max(1, parseInt(r.dataset.qty || '1', 10) || 1), 0);
        listEl.classList.toggle('hidden', rows.length === 0);
        if (emptyEl) emptyEl.classList.toggle('hidden', rows.length > 0);
      }
      const navLabel = document.getElementById('nav-basket-label');
      if (navLabel) navLabel.textContent = `Basket (${basketCount})`;
      const countEl = document.getElementById('basket-item-count');
      if (countEl) countEl.textContent = basketCount;
    }

    function syncHandoffNotes() {
      const steps = document.getElementById('chk-steps').checked;
      const wait = document.getElementById('chk-wait').checked;
      const parts = [];
      if (steps) parts.push('Walk up 4 porch steps');
      if (wait) parts.push('wait 60s');
      const noteEl = document.getElementById('live-handoff-note');
      if (noteEl) {
        noteEl.textContent = parts.length ? 'Handoff: ' + parts.join(' & ') : 'Handoff: Standard door dropoff';
