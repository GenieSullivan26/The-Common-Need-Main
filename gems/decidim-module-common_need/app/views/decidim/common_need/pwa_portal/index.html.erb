    function removeLiveSurplusItem(itemId) {
      if (!itemId) return;
      const existing = getStoredLiveSurplusItems();
      const target = existing.find(i => i.id === itemId);
      const next = existing.filter(i => i.id !== itemId);
      try {
        localStorage.setItem('common_need_live_surplus_items', JSON.stringify(next));
