    function postSurplusItem() {
      const nameInput = document.getElementById('surplus-name-input');
      const qtyInput = document.getElementById('surplus-qty-input');
      const catSelect = document.getElementById('surplus-cat-select');
      const name = (nameInput.value || '').trim() || 'Fresh Bok Choy & Ginger Bundle';
      const qty = qtyInput.value || '20';
      const chosenCat = catSelect ? catSelect.value : 'auto';
      const inst = getActiveInstanceInfo();

      const newItem = {
        id: 'surplus-' + Date.now(),
        title: name,
        qty: String(qty),
        category: (!chosenCat || chosenCat === 'auto') ? inferSurplusCategory(name) : chosenCat,
        instanceCode: inst.code,
        postedAt: new Date().toISOString()
      };

      try {
        const existing = getStoredLiveSurplusItems();
        existing.unshift(newItem);
        localStorage.setItem('common_need_live_surplus_items', JSON.stringify(existing.slice(0, 25)));
      } catch (e) {}

      syncLiveSurplusAndEventsToMemberPwa();
      if (nameInput) nameInput.value = '';
      showToast(`Posted ${qty}x "${name}" — Live in Member Catalog & Resource Navigator!`);
    }

