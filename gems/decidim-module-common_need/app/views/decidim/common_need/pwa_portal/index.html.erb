    function deleteLivePartnerEvent(eventId) {
      if (!eventId) return;
      const existing = getStoredLivePartnerEvents();
      const target = existing.find(e => e.id === eventId);
      const next = existing.filter(e => e.id !== eventId);
      try {
        localStorage.setItem('common_need_live_partner_events', JSON.stringify(next));
      } catch (e) {}
      syncLiveSurplusAndEventsToMemberPwa();
      showToast(`Unpublished "${target ? target.title : 'event'}" from the Member Calendar.`);
    }

    function postPartnerCalendarEvent() {
      const titleInput = document.getElementById('partner-event-title');
      const daySelect = document.getElementById('partner-event-day');
      const timeInput = document.getElementById('partner-event-time');
      const catInput = document.getElementById('partner-event-cat');
      const locInput = document.getElementById('partner-event-location');
      const capInput = document.getElementById('partner-event-capacity');
      const descInput = document.getElementById('partner-event-desc');

      const title = (titleInput?.value || '').trim() || 'Pop-Up Winter Coat & Hot Soup Distribution';
      const dayVal = daySelect ? daySelect.value : 'Thu Nov 5';
      const rawTime = (timeInput?.value || '').trim();
      const baseDayText = daySelect ? daySelect.options[daySelect.selectedIndex].text : dayVal;
      const dayLabel = rawTime && !baseDayText.includes('•') ? `${dayVal} • ${rawTime}` : baseDayText;
      const catLabel = (catInput?.value || '').trim() || '🤝 MUTUAL AID • 🍎 FOOD';
      const location = (locInput?.value || '').trim() || '7800 MacArthur Blvd';
      const capacity = Math.max(1, parseInt(capInput?.value || '50', 10) || 50);
      const desc = (descInput?.value || '').trim() || 'Newly posted partner community event on the local node calendar. Open to all neighbors with zero means-testing.';

      const childcare = document.getElementById('partner-ev-opt-childcare') ? document.getElementById('partner-ev-opt-childcare').classList.contains('active') : true;
      const ada = document.getElementById('partner-ev-opt-ada') ? document.getElementById('partner-ev-opt-ada').classList.contains('active') : true;
      const interp = document.getElementById('partner-ev-opt-interp') ? document.getElementById('partner-ev-opt-interp').classList.contains('active') : false;
      const delivery = document.getElementById('partner-ev-opt-delivery') ? document.getElementById('partner-ev-opt-delivery').classList.contains('active') : false;

      const inst = getActiveInstanceInfo();
      const hostName = (inst.userName && !/rosa|marcus/i.test(inst.userName) && inst.userName.includes(' '))
        ? (inst.userName === 'Elena Rostova' ? 'East Oakland Collective Pantry' : inst.userName)
        : 'East Oakland Collective Pantry';

      const newEv = {
        id: 'ev-' + Date.now(),
        title,
        dayVal,
        dayLabel,
        catLabel,
        location,
        capacity,
        desc,
        childcare,
        ada,
        interp,
        delivery,
        hostName,
        orgCode: 'east_oakland',
        postedAt: new Date().toISOString()
      };

      try {
        const existing = getStoredLivePartnerEvents();
        existing.unshift(newEv);
        localStorage.setItem('common_need_live_partner_events', JSON.stringify(existing.slice(0, 25)));
      } catch (e) {}

      renderPartnerEventCardDom(newEv);
      syncLiveSurplusAndEventsToMemberPwa();
      if (titleInput) titleInput.value = '';
      if (locInput) locInput.value = '';
      if (descInput) descInput.value = '';
      showToast(`Published "${title}" (${dayLabel}) — Live now on Member PWA Calendar!`);
    }

    function toggleDeliveryUpdatesBanner(forceOpen) {
      const bodyEl = document.getElementById('basket-delivery-updates-body');
      const btnEl = document.getElementById('delivery-banner-toggle-btn');
      if (!bodyEl || !btnEl) return;

      const isCurrentlyHidden = bodyEl.classList.contains('hidden');
      const shouldOpen = typeof forceOpen === 'boolean' ? forceOpen : isCurrentlyHidden;

      bodyEl.classList.toggle('hidden', !shouldOpen);
      btnEl.textContent = shouldOpen ? '▲ Collapse' : '▼ Details';
    }

